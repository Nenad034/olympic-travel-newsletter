# Claude API — punjenje šablona sadržajem (spec §5.2). Bez ključa aplikacija koristi
# deterministički lokalni "mock" popunjivač, pa sve radi i offline.
ANTHROPIC_API_KEY=

# Listmonk motor (spec §2). Bez ovih vrednosti se koristi ugrađeni file-backed mock
# (data/store.json) koji oponaša Listmonk liste/pretplatnike/kampanje.
LISTMONK_URL=
LISTMONK_USER=
LISTMONK_PASSWORD=
# ID Listmonk transakcionog šablona (renderuje {{ .Tx.Data.body }}) za operativni B2B tok (§3.1.1)
LISTMONK_TX_TEMPLATE_ID=1

# Zajednička tajna za webhook rute (/api/webhooks/*) — zaglavlje x-webhook-secret
WEBHOOK_SECRET=
