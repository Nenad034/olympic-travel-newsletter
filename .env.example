# Claude API — punjenje šablona sadržajem (spec §5.2). Bez ključa aplikacija koristi
# deterministički lokalni "mock" popunjivač, pa sve radi i offline.
ANTHROPIC_API_KEY=

# Listmonk motor (spec §2). Bez ovih vrednosti se koristi ugrađeni file-backed mock
# (data/store.json) koji oponaša Listmonk liste/pretplatnike/kampanje.
# Listmonk v4+ prima samo API korisnika sa tokenom (Podešavanja → Korisnici → tip „API").
# Lokalno: docker compose -f docker/listmonk/docker-compose.yml up -d
#          node scripts/listmonk-dev-setup.mjs   (napravi API korisnika, SMTP → Mailpit, ispiše redove)
# Liste i šablone u Listmonk-u pravi sam modul: SES i domeni → „Poveži sa Listmonk-om".
LISTMONK_URL=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=

# Zajednička tajna za webhook rute (/api/webhooks/*) — zaglavlje x-webhook-secret
WEBHOOK_SECRET=
